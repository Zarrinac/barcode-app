generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum MovementType {
  INBOUND
  OUTBOUND
}

enum SerialStatus {
  REGISTERED
  EDITED
  EXITED
  CANCELLED
}

enum RecordSource {
  MANUAL
  PDA
  LEGACY_IMPORT
}

model User {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  legacyFlag   Int      @default(0)
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model ProductModel {
  id           Int            @id @default(autoincrement())
  modelName    String
  productCode  String
  warrantyCode String         @default("")
  isActive     Boolean        @default(true)
  legacyFlag   Int            @default(0)
  source       RecordSource   @default(MANUAL)
  createdAt    DateTime       @default(now())
  createdBy    String?
  updatedAt    DateTime       @updatedAt
  updatedBy    String?
  serials      SerialRecord[]

  @@index([productCode])
  @@index([modelName])
  @@index([isActive])
  @@map("product_models")
}

model WarehouseLocation {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  name        String
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  serials     SerialRecord[]

  @@index([isActive])
  @@map("warehouse_locations")
}

model SerialRecord {
  id             Int                @id @default(autoincrement())
  docDate        String
  documentNo     String
  customerName   String
  productCode    String
  modelName      String
  trackingCode   String
  serialNo       String
  movement       MovementType       @default(INBOUND)
  status         SerialStatus       @default(REGISTERED)
  source         RecordSource       @default(MANUAL)
  productModelId Int?
  locationId     Int?
  legacyFlag     Int                @default(0)
  createdAt      DateTime           @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  productModel   ProductModel?      @relation(fields: [productModelId], references: [id], onDelete: SetNull)
  location       WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([serialNo])
  @@index([trackingCode])
  @@index([productCode])
  @@index([modelName])
  @@index([documentNo])
  @@index([docDate])
  @@index([movement])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([productModelId])
  @@index([locationId])
  @@index([serialNo, productCode])
  @@index([documentNo, docDate])
  @@map("serial_records")
}
