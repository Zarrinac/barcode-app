# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.tmp

# next.js
/.next/
/out/

# production
/build

# android generated/local artifacts
/android/.gradle/
/android/**/build/
/android/local.properties
/android/.cxx/
/android/.externalNativeBuild/
/android/captures/
/android-native/.gradle/
/android-native/**/build/
/android-native/local.properties
/android-native/.cxx/
/android-native/.externalNativeBuild/
/android-native/captures/
*.iml

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# dev server logs
.next-dev*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify local/cache artifacts
/graphify-out/.graphify_python
/graphify-out/.graphify_root
/graphify-out/cache/
